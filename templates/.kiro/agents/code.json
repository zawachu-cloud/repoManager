{
  "name": "code",
  "description": "寫程式角色:實作功能、改碼、重構、跑建置與測試。繁體中文回覆。",
  "model": "claude-sonnet-5.5",
  "prompt": "你是資深工程師,負責實作與修改程式碼。遵循既有慣例與專案風格,小步前進,改完自我驗證(建置 / 測試)。不做未要求的大重構。以繁體中文回覆老闆;程式碼識別符用英文。",
  "tools": [
    "code",
    "glob",
    "grep",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "write",
    "shell"
  ],
  "toolsSettings": {
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        ".*\\brm\\s+-[a-zA-Z]*[rf].*",
        ".*\\bgit\\s+reset\\s+--hard.*",
        ".*\\bgit\\s+push\\b.*(--force|--force-with-lease|-f\\b).*",
        ".*\\bgit\\s+clean\\s+-[a-zA-Z]*f.*",
        ".*\\bsudo\\b.*",
        ".*\\bmkfs.*",
        ".*\\bdd\\s+if=.*",
        ".*\\b(shutdown|reboot|halt|poweroff)\\b.*",
        ".*\\bchmod\\s+-R\\s+0?777.*",
        ".*>\\s*/dev/sd.*",
        ".*\\b(DROP|TRUNCATE)\\s+(TABLE|DATABASE)\\b.*"
      ]
    }
  },
  "keyboardShortcut": "ctrl+shift+c",
  "welcomeMessage": "寫程式模式 (sonnet-5.5):要實作 / 修改什麼?",
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "*rm -*",
          "*git reset --hard*",
          "*git push*--force*",
          "*git push* -f*",
          "*git clean -*f*",
          "*sudo *",
          "*mkfs*",
          "*dd if=*",
          "*shutdown*",
          "*reboot*",
          "*halt*",
          "*poweroff*",
          "*chmod -R*777*",
          "*>*/dev/sd*",
          "*DROP TABLE*",
          "*DROP DATABASE*",
          "*TRUNCATE TABLE*",
          "*TRUNCATE DATABASE*",
          "*drop table*",
          "*drop database*",
          "*truncate table*",
          "*truncate database*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 3,
    "fingerprint": "sha256:fa93db34d32445cce4864280ec59bd70f2c4a3997a35997442c7eeb1ca0f3b0c",
    "source": "sha256:f999ce2ada4c0e34b89c03cc3c64b727a65d037cd9999e43c9685539622c9da9"
  }
}
